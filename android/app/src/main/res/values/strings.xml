    <string name="howItWorks_close">Close</string>
    <string name="howItWorks_intro">This app shows weather history and forecast for your current location and any places you\'ve saved as favorites — what\'s already happened, and what\'s expected next.</string>
    <string name="howItWorks_windowsIntro">Use the</string>
    <string name="howItWorks_and">and</string>
    <string name="howItWorks_windowsOutro">tabs to change how far back and forward each view looks — from an hour-by-hour look at today to a week-long overview.</string>
    <string name="howItWorks_chartIntro">On every chart, a solid line or bar is an</string>
    <string name="howItWorks_observedWord">observed</string>
    <string name="howItWorks_chartMiddle">reading — something that already happened — while a dashed one is a</string>
    <string name="howItWorks_forecastWord">forecast</string>
    <string name="howItWorks_chartOutro">: a prediction for a time that hasn\'t arrived yet.</string>
    <string name="howItWorks_dataSources">Weather data comes from SMHI (Sweden\'s national weather service), Open-Meteo, and MET Norway. For Swedish locations the app prefers real station observations and blends forecasts from all three sources when more than one has data; elsewhere it falls back to Open-Meteo.</string>
    <string name="howItWorks_uvPrefix">A small</string>
    <string name="howItWorks_uvSuffix">badge appears on the weather icon for any already-happened hour whose UV index was high enough to matter — it only ever reflects real measurements, never a forecast guess.</string>
    <string name="howItWorks_warnings">If Sweden\'s weather service has an official warning active for a saved location — storms, flooding, water shortage, and similar — a banner appears near the top of the page summarizing it, expandable for the full details.</string>
    <string name="howItWorks_characters">The two characters on the Today card are not weather data. They dress for the current temperature and conditions, so you can tell at a glance whether to bring a coat or an umbrella.</string>
    <string name="privacyNotice_ariaLabel">Privacy notice</string>
    <string name="privacyNotice_close">Close</string>
    <string name="privacyNotice_storage">This app runs entirely in your browser — there is no backend server and no account. Your favorite places, last-viewed location, and display preferences (theme, units, toggles) are saved only in this browser\'s local storage; they are never sent anywhere.</string>
    <string name="privacyNotice_dataSources">Weather data comes directly from SMHI and Open-Meteo\'s public APIs, requested by your browser each time you view it.</string>
    <string name="privacyNotice_analytics">This site uses Google Analytics to collect anonymous usage statistics (pages viewed, general interaction patterns) to help understand how the app is used.</string>
