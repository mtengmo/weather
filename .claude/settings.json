{
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__tabs_context_mcp",
      "ClaudeInChromeDomain(localhost:5173)",
      "ClaudeInChromeDomain(localhost:5174)",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "ClaudeInChromeDomain(localhost:5199)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-file-size.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-bash-read.sh"
          }
        ]
      }
    ]
  }
}
